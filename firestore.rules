rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /photos/{photoId} {
      // Anyone with the link can see the shared photo wall.
      allow read: if true;

      // Anyone can add a photo entry, but only with the expected shape
      // and no ability to edit or delete existing entries.
      allow create: if request.resource.data.keys().hasAll(['name', 'url', 'uploadedAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 100
                    && request.resource.data.url is string;

      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
